# IT EXPERTS — THE PROOF ROOM
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values before production deployment.

# Database Configuration (PostgreSQL in Docker / Production, or SQLite locally)
POSTGRES_USER=itexperts
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=itexperts_proof_room
DATABASE_URL=postgresql://itexperts:replace_with_strong_database_password@localhost:5432/itexperts_proof_room

# JWT Security & Admin Bootstrap
JWT_SECRET_KEY=replace_with_cryptographic_256bit_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_DEFAULT_EMAIL=admin@itexperts.dev
ADMIN_DEFAULT_PASSWORD=replace_with_strong_admin_password

# File Uploads & Direct Contact
UPLOAD_DIR=./uploads
WHATSAPP_NUMBER=+967781282285
